39:{"metadata":[["$","title","0",{"children":"winnow — what pruning a Claude Code session actually costs"}],["$","meta","1",{"name":"description","content":"Several tools will strip tool output from a Claude Code session. None of them can tell you whether stripping it saved you anything, because the conversation sits in the API's cached prefix at 0.1× and every edit forces a full-price rewrite of everything after the cut. winnow measures that trade before it makes it. The pruner does not exist yet."}],["$","meta","2",{"name":"application-name","content":"winnow"}],["$","meta","3",{"name":"author","content":"winnow"}],["$","meta","4",{"name":"keywords","content":"Claude Code,context pruning,prompt cache,tool output,transcript,cache invalidation"}],["$","meta","5",{"name":"robots","content":"index, follow"}],["$","link","6",{"rel":"canonical","href":"https://winnow-web.vercel.app"}],["$","meta","7",{"property":"og:title","content":"winnow — An instrument for deciding whether pruning a Claude Code session is worth what it costs."}],["$","meta","8",{"property":"og:description","content":"Several tools will strip tool output from a Claude Code session. None of them can tell you whether stripping it saved you anything, because the conversation sits in the API's cached prefix at 0.1× and every edit forces a full-price rewrite of everything after the cut. winnow measures that trade before it makes it. The pruner does not exist yet."}],["$","meta","9",{"property":"og:url","content":"https://winnow-web.vercel.app"}],["$","meta","10",{"property":"og:site_name","content":"winnow"}],["$","meta","11",{"property":"og:locale","content":"en_GB"}],["$","meta","12",{"property":"og:image:alt","content":"winnow — An instrument for deciding whether pruning a Claude Code session is worth what it costs."}],["$","meta","13",{"property":"og:image:type","content":"image/png"}],["$","meta","14",{"property":"og:image","content":"https://winnow-web.vercel.app/opengraph-image?92c5dfd9b94d3a04"}],